rules_version = '2';

// Each user reads and writes only their own tree: users/{uid}/...
service cloud.firestore {
  match /databases/{database}/documents {
    // UPD-01: minimum supported builds; anyone can read it (also before signing in), nobody writes it from the app
    match /config/app {
      allow read: if true;
      allow write: if false;
    }
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
