<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup on Android 11 and older (PRIV-01). Same decision as data_extraction_rules.xml: the
    account's data is restored from Firestore, so the local copy is not backed up.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
