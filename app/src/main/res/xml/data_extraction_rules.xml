<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device transfer (PRIV-01).
    The account's data lives in Firestore and comes back when the user signs in, so the local
    copy (Room, DataStore, cached exports) is left out of Google's backup and of phone-to-phone
    transfer: it holds third parties' phone numbers and could restore another account's data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
